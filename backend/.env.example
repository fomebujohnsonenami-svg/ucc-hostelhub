# Local development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fill in using the Supabase Connect panel when a database is available.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
# Optional persistent local SQLite file in development (ignored by Git).
SQLITE_PATH=

# Set the project HTTPS origin, with no path or trailing slash.
SUPABASE_URL=
# Leave empty for JWKS/ES256 or RS256. Use only for legacy HS256 projects.
SUPABASE_JWT_SECRET=
# Backend-only legacy service-role key for Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_HOSTEL_BUCKET=hostel-images
SUPABASE_AVATAR_BUCKET=avatars
# For sslmode=verify-full, provide the trusted CA path if libpq requires one.
POSTGRES_SSLROOTCERT=
# Optional raw multiline CA PEM, useful on Vercel. Takes precedence over the file path.
POSTGRES_SSLROOTCERT_PEM=
AVAILABILITY_STALE_HOURS=48

# University presentation: temporary access, without a paid subscription.
PRESENTATION_MODE=false

# Hosting settings. See docs/deployment.md before enabling production mode.
DJANGO_ENV=development
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HTTPS=false
# Opt in only for an isolated presentation project.
DEMO_SEED_ENABLED=false
