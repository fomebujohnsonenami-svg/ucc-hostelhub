# VITE_ values are public browser configuration.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional Leaflet tile provider. Leave empty for the OpenStreetMap defaults.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Presentation UI only. Backend access is configured separately.
VITE_PRESENTATION_MODE=false
